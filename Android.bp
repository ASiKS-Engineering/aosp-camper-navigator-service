
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "camper_navigator_service_aidl",
    srcs: [
        "aidl/com/asiks/camper/navigator/ICamperNavigatorManager.aidl",
    ],
    visibility: [
        "//visibility:public",
    ],
}

java_library {
    name: "camper-navigator-service",
    srcs: [
        "service/java/**/*.java",
    ],

    aidl: {
        local_include_dirs: [
            "aidl",
        ],
    },

    libs: [
        "framework",
    ],

    visibility: [
        "//visibility:public",
    ],
}
